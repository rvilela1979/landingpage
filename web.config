<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <location path="" overrideMode="Inherit">
        <system.webServer>
            <urlCompression doDynamicCompression="false" />
            <handlers>
                <add name="PHP-FastCGI8.3" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\php8.3\php-cgi.exe" resourceType="File" />
            </handlers>
            <defaultDocument enabled="true">
                <files>
                    <add value="index.htm" />
                    <add value="index.html" />
                </files>
            </defaultDocument>
        </system.webServer>
    </location>
</configuration>
